  "description": "手机优先的 DeepSeek Harness 客户端：32KB 页面、SSE 实时输出、审批留在手机、Mermaid 图表、图片发送。无需改宿主，装成 bundle 即可用 Tailscale / Cloudflare 访问。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "remote-control",
    "tailscale",
    "cloudflare-tunnel"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/icon.png",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rainfish-home/dsh-mobi-web.git"
  },
  "bugs": {
    "url": "https://github.com/rainfish-home/dsh-mobi-web/issues"
  },
  "homepage": "https://github.com/rainfish-home/dsh-mobi-web#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
